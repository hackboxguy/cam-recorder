#!/bin/sh
# camview — minimal live camera view on the local display.
#
# The quick "is the camera alive" check. cam-recorder is the app that also
# records; this stays deliberately simple. The two are mutually exclusive
# (Conflicts= in their units) because /dev/video0 is exclusive.
#
# Portable across the two platforms this repo serves, selected at runtime:
#   tegra    nvvidconv (hardware flip+scale) -> nvdrmvideosink
#   generic  videoconvert/videoscale (CPU)   -> kmssink
# Override with CAM_PLATFORM=tegra|generic, CAM_DEVICE=, CAM_FLIP=.
#
# No source caps are forced anywhere below - the device decides. That is what
# lets this work with any sensor, and on tegra it also dodges a negotiation
# trap: v4l2src emits DMABuf/DMA_DRM "R8" (native mono), and forcing plain
# GRAY8 system memory hits BOTH a videoconvert/videoflip slow-path bug ("not
# implemented") AND nvvidconv's rejection of the padded 1152 stride. Letting
# videoconvert take the DMABuf R8 -> RGBA also tightens the stride for
# nvvidconv. Do NOT add bayer2rgb: the sensor is native GREY, and demosaicing
# mono data just adds colour fringing.
set -eu

DEV="${CAM_DEVICE:-/dev/video0}"
FLIP="${CAM_FLIP:-}"

if [ -n "${CAM_PLATFORM:-}" ]; then
    PLATFORM="$CAM_PLATFORM"
elif gst-inspect-1.0 nvdrmvideosink >/dev/null 2>&1; then
    PLATFORM=tegra
else
    PLATFORM=generic
fi

# Wait for the node: on Pi the media pipeline is configured by a separate
# oneshot unit, and on tegra the driver may still be probing.
n=0
while [ ! -e "$DEV" ] && [ "$n" -lt 30 ]; do n=$((n + 1)); sleep 0.5; done
[ -e "$DEV" ] || { echo "camview: $DEV never appeared" >&2; exit 1; }

if [ "$PLATFORM" = tegra ]; then
    # flip-method=2 (nvvidconv, HARDWARE) corrects this rig's upside-down mount.
    # Do NOT substitute videoflip here: a CPU rotate-180 on 1124x1364 nearly
    # HALVES the frame rate on this board (measured 300 frames: 21 s vs 11 s).
    # nvvidconv folds the rotation into the scale pass it already performs.
    #
    # sync=true is REQUIRED - nvdrmvideosink schedules DRM page-flips off the
    # clock, and sync=false blanks the display entirely. qos=false and
    # max-lateness=-1 disable ONLY the late-buffer dropping: with the defaults
    # the sink discarded frames it judged late against an undisciplined clock
    # (the Orin Nano devkit has no battery-backed RTC), so the feed visibly
    # stuttered while camera and CSI link were perfectly healthy.
    #
    # offset-x=0 puts this view on the LEFT; cam-recorder centres itself, so
    # the two are distinguishable at a glance.
    [ -n "$FLIP" ] || FLIP=2
    echo "camview: tegra (flip=$FLIP)"
    exec gst-launch-1.0 -e v4l2src device="$DEV" \
        ! videoconvert ! video/x-raw,format=RGBA \
        ! nvvidconv flip-method="$FLIP" \
        ! "video/x-raw(memory:NVMM),format=RGBA,width=888,height=1080" \
        ! nvdrmvideosink sync=true qos=false max-lateness=-1 offset-x=0
fi

# generic: kmssink only negotiates at the DISPLAY MODE SIZE - a smaller buffer
# fails not-negotiated(-4) with or without render-rectangle - so scale to the
# connected panel's mode. add-borders keeps the aspect ratio (this sensor is
# portrait, the panel is landscape).
[ -n "$FLIP" ] || FLIP=0
W=1920; H=1080
for c in /sys/class/drm/card*/card*-*; do
    [ "$(cat "$c/status" 2>/dev/null)" = connected ] || continue
    m="$(head -n 1 "$c/modes" 2>/dev/null)"
    case "$m" in [0-9]*x[0-9]*) W="${m%x*}"; H="${m#*x}"; break ;; esac
done
echo "camview: generic, rendering into ${W}x${H} (flip=$FLIP)"

# A CPU rotate is affordable here (measured 2 dropped frames in 300 on a Pi 5),
# unlike on tegra - but it is off by default because the EVK rig is mounted the
# right way up.
if [ "$FLIP" != 0 ]; then
    exec gst-launch-1.0 -e v4l2src device="$DEV" io-mode=mmap \
        ! videoflip method=rotate-180 \
        ! videoconvert ! videoscale add-borders=true \
        ! "video/x-raw,width=${W},height=${H},pixel-aspect-ratio=1/1" \
        ! kmssink force-modesetting=true
fi
exec gst-launch-1.0 -e v4l2src device="$DEV" io-mode=mmap \
    ! videoconvert ! videoscale add-borders=true \
    ! "video/x-raw,width=${W},height=${H},pixel-aspect-ratio=1/1" \
    ! kmssink force-modesetting=true
